# MerlinPlatform's settings that are not secret (the Grid token is read from SSM at start).
ASP_URL=https://mutinynet.arkade.sh
PLATFORM_STORE=/srv/platform/state.json
# The release's measurements, written by deploy.sh. No trust_root: the AWS Nitro root.
ENCLAVE_PINS=/srv/platform/enclave-pins.json
# ponytail: one fixed rate on the Grid sandbox; a price feed before real money.
PLATFORM_SATS_PER_USD=1000
