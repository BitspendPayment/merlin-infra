[Unit]
Description=Caddy: TLS for MerlinPlatform on :8443
After=network-online.target
Wants=network-online.target

[Service]
# Its own certificate for the enclave's name, over HTTP-01 on :80; :443 is the enclave's, and the
# enclave's certificate never leaves it. Kept in /var/lib/caddy across restarts and stops.
DynamicUser=yes
StateDirectory=caddy
Environment=XDG_DATA_HOME=/var/lib XDG_CONFIG_HOME=/var/lib
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/caddy reverse-proxy --from https://mutiny.vtxos.network:8443 --to 127.0.0.1:7200
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
